CREATE VERTEX Patient (PRIMARY_ID id STRING, name STRING) WITH STATS="OUTDEGREE_BY_EDGETYPE"
CREATE VERTEX Symptom (PRIMARY_ID name STRING)
CREATE VERTEX Disease (PRIMARY_ID name STRING)
CREATE VERTEX Treatment (PRIMARY_ID name STRING)

CREATE DIRECTED EDGE HAS_SYMPTOM (FROM Patient, TO Symptom)
CREATE DIRECTED EDGE INDICATES (FROM Symptom, TO Disease)
CREATE DIRECTED EDGE TREATED_BY (FROM Disease, TO Treatment)

CREATE GRAPH HealthcareGraph (*)
